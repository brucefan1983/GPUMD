-    PRINT_INPUT_ERROR(error.c_str());
-  }
+  read_nep_file(filename, model);
   std::vector<std::string> mismatches;
   if (fine_tune) {
     compare_with_nep_txt_fine_tune(para, model, filename, mismatches);
