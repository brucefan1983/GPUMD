   if (ferror(file)) {
     PRINT_INPUT_ERROR("Failed to write the NEP model.");
   }
@@ -748,10 +729,7 @@ static void check_nep_file(
   const NEP_Parameters& para, const std::string& filename, bool fine_tune)
